{
  "name": "@the-magic-tower/fixhive-opencode-plugin",
  "version": "0.1.5",
  "description": "Community-based error knowledge sharing for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "build:dts": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "error",
    "knowledge",
    "community",
    "ai",
    "developer-tools",
    "debugging"
  ],
  "author": "Seoul Ventures",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMagicTower/FixHive.git"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "better-sqlite3": "^11.3.0",
    "openai": "^4.60.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.1.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "zod": "^4.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
