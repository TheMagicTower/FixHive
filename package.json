{
  "name": "@the-magic-tower/fixhive-opencode-plugin",
  "version": "0.2.0-beta.2",
  "description": "Community-based error knowledge sharing for OpenCode (CodeCaseDB v2.0)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external better-sqlite3 && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "bun build src/index.ts --outdir dist --target bun --format esm --external better-sqlite3 --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "codecasedb",
    "error",
    "knowledge",
    "community",
    "ai",
    "developer-tools",
    "debugging"
  ],
  "author": "The Magic Tower",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMagicTower/FixHive.git"
  },
  "dependencies": {
    "@the-magic-tower/fixhive-shared": "github:TheMagicTower/fixhive-shared",
    "@opencode-ai/plugin": "^1.1.1",
    "better-sqlite3": "^12.5.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
